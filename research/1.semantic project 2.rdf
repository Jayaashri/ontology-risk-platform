<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4/"
     xml:base="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasActor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasActor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Scene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Actor"/>
        <rdfs:comment>Links a scene to the actors present in it.</rdfs:comment>
        <rdfs:label>has actor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasCornerCaseType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasCornerCaseType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase"/>
        <rdfs:comment>Specifies the type of anomaly associated with a corner case.</rdfs:comment>
        <rdfs:label>has corner case type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasEvidence -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasEvidence">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EvidenceIndicator"/>
        <rdfs:comment>Links a corner case to observable evidence indicating potential risks.</rdfs:comment>
        <rdfs:label>has evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasObstacle -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasObstacle">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Scene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Obstacle"/>
        <rdfs:comment>Links a scene to obstacles present in it.</rdfs:comment>
        <rdfs:label>has obstacle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasPedestrian -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasPedestrian">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Scene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Pedestrian"/>
        <rdfs:comment>Links a scene to pedestrians present in it.</rdfs:comment>
        <rdfs:label>has pedestrian</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasRisk -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasRisk">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Risk"/>
        <rdfs:comment>Links a corner case scenario to the risks identified in it.</rdfs:comment>
        <rdfs:label>has risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasRoadObject -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasRoadObject">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Scene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#RoadObject"/>
        <rdfs:comment>Links a scene to road objects present in it.</rdfs:comment>
        <rdfs:label>has road object</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasSceneType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasSceneType">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Scene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Scene"/>
        <rdfs:comment>Describes the type of environment where the scene takes place.</rdfs:comment>
        <rdfs:label>has scene type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasVehicle -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasVehicle">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Scene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Vehicle"/>
        <rdfs:comment>Links a scene to vehicles present in it.</rdfs:comment>
        <rdfs:label>has vehicle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasWeatherCondition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasWeatherCondition">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Scene"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#WeatherCondition"/>
        <rdfs:comment>Describes the environmental weather conditions affecting the scene.</rdfs:comment>
        <rdfs:label>has weather condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#indicatesPotentialRisk -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#indicatesPotentialRisk">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EvidenceIndicator"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Risk"/>
        <rdfs:comment>Links evidence indicators to the risks they suggest.</rdfs:comment>
        <rdfs:label>indicates potential risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#occursInScene -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#occursInScene">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Scene"/>
        <rdfs:comment>Specifies the scene in which a corner case occurs.</rdfs:comment>
        <rdfs:label>occurs in scene</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasDescription -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasDescription">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Provides a textual description of a scenario or identified risk.</rdfs:comment>
        <rdfs:label>has description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasScenarioName -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasScenarioName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Stores the name or identifier of the corner case scenario</rdfs:comment>
        <rdfs:label>has scenario name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasSeverityScore -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#hasSeverityScore">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Risk"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label>has severity score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Actor -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Actor">
        <rdfs:comment>A dynamic entity in the scene such as a vehicle or pedestrian.</rdfs:comment>
        <rdfs:label>Actor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Advertisement -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Advertisement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#RoadObject"/>
        <rdfs:comment>A visual display such as a billboard that may distract or be misinterpreted as a traffic sign.</rdfs:comment>
        <rdfs:label>Advertisement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Ambulance -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Ambulance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EmergencyVehicle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#AnimalNearRoadIndicator -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#AnimalNearRoadIndicator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EvidenceIndicator"/>
        <rdfs:comment>Presence of animals near the road indicating unpredictable movement and potential collision risk.</rdfs:comment>
        <rdfs:label>Animal Near Road Indicator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Barrel -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Barrel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Obstacle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#BehaviorAnomaly -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#BehaviorAnomaly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase"/>
        <rdfs:comment>A situation where an actor behaves in an unexpected or unsafe way.</rdfs:comment>
        <rdfs:label>Behavior Anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#BrokenLine -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#BrokenLine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#LaneMarking"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Bus -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Bus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Vehicle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Car -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Car">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Vehicle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#ClearCondition -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#ClearCondition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#WeatherCondition"/>
        <rdfs:comment>Weather condition with clear visibility and no significant environmental disturbances.</rdfs:comment>
        <rdfs:label>Clear Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CollisionRisk -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CollisionRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Risk"/>
        <rdfs:comment>Risk of a collision between the vehicle and another object or actor.</rdfs:comment>
        <rdfs:label>Collision Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#ConstructionBarricade -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#ConstructionBarricade">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Obstacle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#ConstructionWorker -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#ConstructionWorker">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Pedestrian"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#ConstructionZoneIndicator -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#ConstructionZoneIndicator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EvidenceIndicator"/>
        <rdfs:comment>Presence of construction activity indicating potential hazards such as workers or blocked lanes.</rdfs:comment>
        <rdfs:label>Construction Zone Indicator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase">
        <rdfs:comment>A rare or unusual driving scenario that may pose safety risks.</rdfs:comment>
        <rdfs:label>Corner Case</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Crosswalk -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Crosswalk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#LaneMarking"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Cyclist -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Cyclist">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Pedestrian"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#DayCondition -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#DayCondition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#WeatherCondition"/>
        <rdfs:comment>Driving conditions during daylight with generally good visibility.</rdfs:comment>
        <rdfs:label>Day Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#DigitalAd -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#DigitalAd">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Advertisement"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Dog -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Dog">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Obstacle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#DoubleLine -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#DoubleLine">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#LaneMarking"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EmergencyVehicle -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EmergencyVehicle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Vehicle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EvidenceBasedAnomaly -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EvidenceBasedAnomaly">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#CornerCase"/>
        <rdfs:comment>A scenario where observable evidence indicates a potential future risk.</rdfs:comment>
        <rdfs:label>Evidence-Based Anomaly</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EvidenceIndicator -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EvidenceIndicator">
        <rdfs:comment>A signal or clue that suggests a potential upcoming risk.</rdfs:comment>
        <rdfs:label>Evidence Indicator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Excavator -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Excavator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Vehicle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#FallenTree -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#FallenTree">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#Obstacle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#FallingObjectIndicator -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#FallingObjectIndicator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EvidenceIndicator"/>
        <rdfs:comment>Evidence of an object falling or likely to fall into the road, posing a hazard.</rdfs:comment>
        <rdfs:label>Falling Object Indicator</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#FireTruck -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#FireTruck">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#EmergencyVehicle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#FoggyCondition -->

    <owl:Class rdf:about="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#FoggyCondition">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/jayaa/ontologies/2026/3/untitled-ontology-4#WeatherCondition"/>
        <rdfs:comment>Weather condition with fog that significantly reduces visibility.</rdfs:comment>
